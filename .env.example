# Global AI toggle
AI_ENABLED=true

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
# One model, or several separated by commas: they are tried in order, so when one model's free
# daily quota is used up the next one takes over.
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-2.5-flash

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Logger settings
# Options: DEBUG, INFO, WARNING, ERROR
APP_LOG_LEVEL=INFO
AI_LOG_LEVEL=DEBUG

# After editing this file, run:  python -m ai.check
